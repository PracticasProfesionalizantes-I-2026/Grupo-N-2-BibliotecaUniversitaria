meta {
  name: Modificar lector (200)
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/lectores/{{lectorId}}
  body: json
  auth: inherit
}

body:json {
  {
    "nombre": "Facundo",
    "apellido": "López",
    "email": "facundo.lopez@example.com",
    "identificador": "35555112"
  }
}

assert {
  res.status: eq 200
}
