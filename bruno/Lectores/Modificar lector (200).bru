meta {
  name: Modificar lector (200)
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/lectores/{{lectorId}}
  body: json
  auth: inherit
}

script:pre-request {
  bru.setEnvVar("lectorIdentificadorModificado", `ID-M-${Date.now()}`);
}

body:json {
  {
    "nombre": "Facundo",
    "apellido": "López",
    "email": "{{lectorEmail}}",
    "identificador": "{{lectorIdentificadorModificado}}"
  }
}

assert {
  res.status: eq 200
}
