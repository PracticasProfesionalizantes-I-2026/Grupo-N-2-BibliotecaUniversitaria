meta {
  name: Modificar lector (200)
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/lectores/{{lectorId}}
  body: json
  auth: inherit
}

script:pre-request {
  bru.setEnvVar("lectorDniModificado", String(30000000 + Math.floor(Math.random() * 60000000)));
}

body:json {
  {
    "nombre": "Facundo",
    "apellido": "López",
    "email": "{{lectorEmail}}",
    "dni": "{{lectorDniModificado}}"
  }
}
