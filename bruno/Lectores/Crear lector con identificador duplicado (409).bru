meta {
  name: Crear lector con identificador duplicado (409)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/lectores
  body: json
  auth: inherit
}

body:json {
  {
    "nombre": "Otro",
    "apellido": "Lector",
    "email": "otro.lector@example.com",
    "identificador": "  {{lectorIdentificador}}  "
  }
}

docs {
  Ejecutar después de "Crear lector (201)" para reusar el mismo
  identificador (con espacios de más, que se recortan antes de comparar)
  y provocar el 409 Conflict de RN-08.
}

assert {
  res.status: eq 409
}
