meta {
  name: Crear lector (201)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/lectores
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "nombre": "Facundo",
    "apellido": "López",
    "email": "facundo.lopez@example.com",
    "identificador": "35555111"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("lectorId", res.body.id);
  }
}
