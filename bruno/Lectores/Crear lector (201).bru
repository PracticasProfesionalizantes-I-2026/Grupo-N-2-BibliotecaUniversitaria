meta {
  name: Crear lector (201)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/lectores
  body: json
  auth: inherit
}

script:pre-request {
  const sufijo = Date.now();
  bru.setEnvVar("lectorEmail", `facundo.lopez.${sufijo}@example.com`);
  bru.setEnvVar("lectorDni", String(30000000 + Math.floor(Math.random() * 60000000)));
}

body:json {
  {
    "nombre": "Facundo",
    "apellido": "López",
    "email": "{{lectorEmail}}",
    "dni": "{{lectorDni}}"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("lectorId", res.body.id);
  }
}
