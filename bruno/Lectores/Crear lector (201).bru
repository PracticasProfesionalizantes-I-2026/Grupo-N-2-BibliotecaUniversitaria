meta {
  name: Crear lector (201)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/lectores
  body: json
  auth: inherit
}

script:pre-request {
  // Valores unicos por corrida para poder ejecutar la coleccion varias
  // veces seguidas sin chocar con lo que quedo de una corrida anterior.
  const sufijo = Date.now();
  bru.setEnvVar("lectorEmail", `facundo.lopez.${sufijo}@example.com`);
  bru.setEnvVar("lectorIdentificador", `ID-${sufijo}`);
}

body:json {
  {
    "nombre": "Facundo",
    "apellido": "López",
    "email": "{{lectorEmail}}",
    "identificador": "{{lectorIdentificador}}"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("lectorId", res.body.id);
  }
}

assert {
  res.status: eq 201
}
