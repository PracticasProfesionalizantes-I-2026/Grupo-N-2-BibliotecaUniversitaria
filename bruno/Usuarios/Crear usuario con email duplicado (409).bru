meta {
  name: Crear usuario con email duplicado (409)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/usuarios
  body: json
  auth: inherit
}

body:json {
  {
    "email": "  Admin@BiblioGest.com  ",
    "password": "Clave123",
    "rolUsuario": "Bibliotecario"
  }
}

docs {
  Mismo email que el administrador semilla, con mayúsculas y espacios de más:
  al normalizarse antes de comparar, debe responder 409 igual.
}

assert {
  res.status: eq 409
}
