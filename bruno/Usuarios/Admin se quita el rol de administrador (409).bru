meta {
  name: Admin se quita el rol de administrador (409)
  type: http
  seq: 13
}

put {
  url: {{baseUrl}}/api/usuarios/{{adminId}}
  body: json
  auth: inherit
}

body:json {
  {
    "email": "admin@bibliogest.com",
    "rolUsuario": "Bibliotecario"
  }
}

docs {
  Ejecutar después de "Obtener id del admin logueado". Un usuario no puede
  quitarse a sí mismo el rol de Administrador (UsuarioAutoModificacionException):
  la cuenta queda intacta tras el 409.
}

assert {
  res.status: eq 409
  res.body.message: eq "No podés desactivar tu propia cuenta ni quitarte el rol de Administrador."
}
