meta {
  name: Modificar usuario (200)
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/api/usuarios/{{usuarioId}}
  body: json
  auth: inherit
}

body:json {
  {
    "email": "{{usuarioEmail}}",
    "rolUsuario": "Administrador"
  }
}

docs {
  La contraseña es opcional en la modificación: si no se envía, se mantiene la actual.
}

assert {
  res.status: eq 200
}
