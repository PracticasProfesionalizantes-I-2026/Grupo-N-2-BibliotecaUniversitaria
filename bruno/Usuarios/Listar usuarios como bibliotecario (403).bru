meta {
  name: Listar usuarios como bibliotecario (403)
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/usuarios
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenBibliotecario}}
}

docs {
  RN-19: ejecutar antes "Auth/Login Bibliotecario (200)" para tener
  tokenBibliotecario cargado. Este request usa ese token explícitamente
  (no el de la colección, que es siempre tokenAdmin).
}

assert {
  res.status: eq 403
}
