meta {
  name: Listar usuarios como bibliotecario (403)
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/usuarios
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  RN-19: ejecutar antes "Auth/Login Bibliotecario (200)" para que el token sea de
  un bibliotecario. Después volver a loguearse como administrador.
}
