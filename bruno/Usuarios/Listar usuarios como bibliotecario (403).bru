meta {
  name: Listar usuarios como bibliotecario (403)
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/usuarios
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenBibliotecario}}
}

docs {
  RN-19: usa el token del bibliotecario (correr antes "Auth/Login Bibliotecario (200)").
  No hace falta volver a loguearse como administrador: el resto de la colección usa tokenAdmin.
}
