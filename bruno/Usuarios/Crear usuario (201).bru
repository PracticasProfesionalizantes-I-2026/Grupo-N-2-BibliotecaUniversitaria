meta {
  name: Crear usuario (201)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/usuarios
  body: json
  auth: inherit
}

script:pre-request {
  bru.setEnvVar("usuarioEmail", `nuevo.bibliotecario.${Date.now()}@bibliogest.com`);
}

body:json {
  {
    "email": "{{usuarioEmail}}",
    "password": "Clave123",
    "rolUsuario": "Bibliotecario"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("usuarioId", res.body.id);
  }
}

assert {
  res.status: eq 201
}
