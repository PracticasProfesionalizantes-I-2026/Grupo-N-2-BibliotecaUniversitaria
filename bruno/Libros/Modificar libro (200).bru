meta {
  name: Modificar libro (200)
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/api/libros/{{libroId}}
  body: json
  auth: inherit
}

body:json {
  {
    "titulo": "El Aleph (2da edición)",
    "autor": "Jorge Luis Borges",
    "isbn": "{{libroIsbn}}",
    "ubicacion": "A1-4",
    "stock": 6
  }
}
