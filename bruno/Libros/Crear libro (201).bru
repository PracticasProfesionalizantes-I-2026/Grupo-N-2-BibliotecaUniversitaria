meta {
  name: Crear libro (201)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/libros
  body: json
  auth: inherit
}

script:pre-request {
  // ISBN-13 valido (con digito verificador correcto) y distinto en cada
  // corrida, para poder ejecutar la coleccion varias veces seguidas.
  function generarIsbn13() {
    const base = [9, 7, 8];
    for (let i = 0; i < 9; i++) {
      base.push(Math.floor(Math.random() * 10));
    }
    let suma = 0;
    for (let i = 0; i < 12; i++) {
      suma += base[i] * (i % 2 === 0 ? 1 : 3);
    }
    const digitoVerificador = (10 - (suma % 10)) % 10;
    return base.join('') + digitoVerificador;
  }
  bru.setEnvVar("libroIsbn", generarIsbn13());
}

body:json {
  {
    "titulo": "El Aleph",
    "autor": "Jorge Luis Borges",
    "isbn": "{{libroIsbn}}",
    "ubicacion": "Estante A4",
    "stock": 4
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("libroId", res.body.id);
  }
}

assert {
  res.status: eq 201
}
