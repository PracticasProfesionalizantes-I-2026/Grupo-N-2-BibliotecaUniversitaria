meta {
  name: Eliminar libro con prestamos activos (409)
  type: http
  seq: 11
}

delete {
  url: {{baseUrl}}/api/libros/{{libroHistLibroId}}
  body: none
  auth: inherit
}

docs {
  Usa el libro/lector/préstamo creados en los 3 requests anteriores de
  esta misma carpeta ("Preparar ... para historial de prestamos/
  historial"), no el {{libroId}} compartido con el resto de la colección
  — así no depende de que la carpeta Prestamos ya haya corrido, y no borra
  ni modifica datos que usan otros requests.
}

assert {
  res.status: eq 409
}
