meta {
  name: Eliminar libro con prestamos activos (409)
  type: http
  seq: 8
}

delete {
  url: {{baseUrl}}/api/libros/{{libroId}}
  body: none
  auth: inherit
}

docs {
  Ejecutar después de "Crear préstamo (201)" en la carpeta Prestamos usando
  este mismo libroId, para que la eliminación choque contra la RN de
  historial de préstamos y devuelva 409 Conflict.
}

assert {
  res.status: eq 409
}
