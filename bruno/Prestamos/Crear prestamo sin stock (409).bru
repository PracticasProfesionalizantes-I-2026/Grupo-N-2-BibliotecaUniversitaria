meta {
  name: Crear prestamo sin stock (409)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/prestamos
  body: json
  auth: inherit
}

body:json {
  {
    "lectorId": "{{lectorId}}",
    "libroId": "{{rayuelaId}}"
  }
}

docs {
  RN-11: usa {{rayuelaId}} ("Rayuela", cargado por el DbInitializer con
  stock 0) en vez de {{libroId}}, para no depender de que algún otro
  request haya dejado el libro propio de esta corrida sin stock.
  {{lectorId}} nunca tomó prestado "Rayuela" (quien lo tiene activo es la
  lectora del seed, Ana Gómez), así que no choca con el 409 de préstamo
  duplicado.
}

assert {
  res.status: eq 409
}
