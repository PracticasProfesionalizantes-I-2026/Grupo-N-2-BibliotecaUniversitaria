meta {
  name: Crear prestamo sin stock (409)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/prestamos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "lector_id": "{{lectorId}}",
    "libro_id": "{{libroId}}"
  }
}

docs {
  Para forzar el 409 de RN-11, usar un libroId cuyo stock ya esté en 0
  (por ejemplo, el libro "Rayuela" cargado por el DbInitializer).
}
