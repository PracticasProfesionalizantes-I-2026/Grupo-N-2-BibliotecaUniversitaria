meta {
  name: Listar prestamos en mora (200)
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/prestamos/mora
  body: none
  auth: inherit
}

script:post-response {
  if (res.status === 200 && res.body.length > 0) {
    bru.setEnvVar("prestamoMoraId", res.body[0].id);
    bru.setEnvVar("lectorMoraId", res.body[0].lectorId);
  }
}

docs {
  Con los datos de prueba del DbInitializer ya debería devolver al menos
  el préstamo vencido de "Rayuela" (lectora Ana Gómez, 6 días de atraso).
  Guarda prestamoMoraId y lectorMoraId para los requests de mora y suspensión.
}
