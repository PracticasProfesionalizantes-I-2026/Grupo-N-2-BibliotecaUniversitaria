meta {
  name: Crear prestamo con lector o libro inexistente (404)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/prestamos
  body: json
  auth: inherit
}

body:json {
  {
    "lectorId": "11111111-1111-1111-1111-111111111111",
    "libroId": "22222222-2222-2222-2222-222222222222"
  }
}

assert {
  res.status: eq 404
}
