meta {
  name: Crear prestamo duplicado del mismo lector y libro (409)
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/api/prestamos
  body: json
  auth: inherit
}

body:json {
  {
    "lectorId": {{lectorId}},
    "libroId": {{libroId}}
  }
}

docs {
  Correr después de "Crear prestamo (201)": el lector ya tiene ese libro prestado (409).
}
