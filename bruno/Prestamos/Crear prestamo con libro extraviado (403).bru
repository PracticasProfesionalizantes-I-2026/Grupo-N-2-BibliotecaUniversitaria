meta {
  name: Crear prestamo con libro extraviado (403)
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/prestamos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "lectorId": {{lectorId}},
    "libroId": {{libroId}}
  }
}

docs {
  Correr después de "Registrar extravio (200)". El lector tiene un libro
  extraviado sin reponer: no puede pedir otro préstamo (403).
}
