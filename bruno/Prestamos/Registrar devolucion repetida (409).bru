meta {
  name: Registrar devolucion repetida (409)
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/api/prestamos/{{prestamoId}}/devolucion
  body: none
  auth: inherit
}

docs {
  Ejecutar después de "Registrar devolucion (200)": el préstamo ya está devuelto,
  así que responde 409 y no vuelve a sumar stock al libro.
}

assert {
  res.status: eq 409
}
